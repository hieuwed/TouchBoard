<Window x:Class="TouchBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TouchBoard"
        Title="Touch Board - Bảng Viết Tương Tác"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E2E"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:BackgroundTypeToBrushConverter x:Key="BgConverter" />
    </Window.Resources>

    <Grid>
        <!-- ============================================ -->
        <!-- INK CANVAS (Full Area, Background Layer)     -->
        <!-- ============================================ -->
        <Canvas x:Name="InfiniteCanvasContainer" ClipToBounds="True">
            <InkCanvas x:Name="DrawingCanvas"
                       Width="100000" Height="100000"
                       Margin="-50000,-50000,0,0"
                       Background="#1E1E2E"
                       EditingMode="Ink"
                       ClipToBounds="False"
                       Focusable="True">
                <InkCanvas.DefaultDrawingAttributes>
                    <DrawingAttributes Color="#CDD6F4"
                                       Width="6" Height="6"
                                       StylusTip="Ellipse"
                                       FitToCurve="True"
                                       IgnorePressure="True"/>
                </InkCanvas.DefaultDrawingAttributes>
            </InkCanvas>
        </Canvas>

        <!-- ============================================ -->
        <!-- SELECTION CONTEXT MENU (⋯ Button + Popup)   -->
        <!-- ============================================ -->
        <Canvas x:Name="SelectionOverlay" Panel.ZIndex="15">
            <Button x:Name="SelectionMenuButton"
                    Visibility="Collapsed"
                    Width="40" Height="40"
                    Click="SelectionMenuButton_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White"
                                BorderBrush="#E1E8ED"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#AAAAAA" BlurRadius="8" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="⋯" FontSize="22" FontWeight="Bold"
                                       Foreground="#2F3542"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-4,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Canvas>

        <!-- Selection Context Popup -->
        <Popup x:Name="SelectionPopup"
               PlacementTarget="{Binding ElementName=SelectionMenuButton}"
               Placement="Right"
               HorizontalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel MinWidth="200">
                    <TextBlock Text="Thao tác vùng chọn"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#8888A8"
                               Margin="8,4,8,8"/>

                    <!-- Color Section -->
                    <TextBlock Text="Đổi màu" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#2F3542" Tag="#2F3542" Click="PopupColor_Click" ToolTip="Đen" Width="30" Height="30"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F38BA8" Tag="#F38BA8" Click="PopupColor_Click" ToolTip="Đỏ hồng" Width="30" Height="30"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#A6E3A1" Tag="#A6E3A1" Click="PopupColor_Click" ToolTip="Xanh lá" Width="30" Height="30"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#89B4FA" Tag="#89B4FA" Click="PopupColor_Click" ToolTip="Xanh dương" Width="30" Height="30"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F9E2AF" Tag="#F9E2AF" Click="PopupColor_Click" ToolTip="Vàng" Width="30" Height="30"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#FAB387" Tag="#FAB387" Click="PopupColor_Click" ToolTip="Cam" Width="30" Height="30"/>
                    </StackPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Stroke Width Section -->
                    <TextBlock Text="Kích thước nét" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                        <Button Click="PopupStrokeWidth_Click" Tag="3" Style="{StaticResource ToolButtonStyle}" Width="44" Height="44" ToolTip="Mảnh (3px)">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="S" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="PopupStrokeWidth_Click" Tag="6" Style="{StaticResource ToolButtonStyle}" Width="44" Height="44" ToolTip="Vừa (6px)">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="M" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="PopupStrokeWidth_Click" Tag="12" Style="{StaticResource ToolButtonStyle}" Width="44" Height="44" ToolTip="Dày (12px)">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="L" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Action Buttons -->
                    <Button Click="PopupCopy_Click" Style="{StaticResource ContextMenuItemStyle}" ToolTip="Sao chép (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sao chép" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="PopupDelete_Click" Style="{StaticResource ContextMenuDangerItemStyle}" ToolTip="Xóa (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa vùng chọn" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Pages Context Popup -->
        <Popup x:Name="PagesPopup"
               PlacementTarget="{Binding ElementName=BtnPages}"
               Placement="Top"
               VerticalOffset="-15"
               HorizontalOffset="-100"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="8">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="15" Opacity="0.4" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel MinWidth="260">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Danh sách Trang" FontSize="16" FontWeight="Bold" Foreground="#2F3542" VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddPage" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" 
                                FontSize="14" FontWeight="Bold" Foreground="#2E86DE" Background="Transparent" 
                                BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Cursor="Hand" Click="BtnAddPage_Click" ToolTip="Tạo trang mới"/>
                    </Grid>
                    
                    <Border Height="1" Background="#E1E8ED" Margin="0,0,0,8"/>

                    <ListBox x:Name="LstPages" Background="Transparent" BorderThickness="0" 
                             MaxWidth="600" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="LstPages_SelectionChanged"
                             PreviewMouseLeftButtonDown="LstPages_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="LstPages_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="LstPages_PreviewMouseLeftButtonUp"
                             PreviewTouchDown="LstPages_PreviewTouchDown"
                             PreviewTouchMove="LstPages_PreviewTouchMove"
                             PreviewTouchUp="LstPages_PreviewTouchUp"
                             Drop="LstPages_Drop"
                             DragOver="LstPages_DragOver"
                             DragLeave="LstPages_DragLeave"
                             AllowDrop="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Left Insert Indicator -->
                                    <Border x:Name="LeftInsertIndicator" Width="3" HorizontalAlignment="Left" 
                                            Background="#2E86DE" Visibility="Collapsed" Margin="-2,0,0,0" CornerRadius="2"/>
                                    
                                    <!-- Main Thumbnail -->
                                    <Border Background="{Binding Theme, Converter={StaticResource BgConverter}}" 
                                            Width="160" Height="90" Margin="4" CornerRadius="6" ClipToBounds="True"
                                            BorderBrush="#E1E8ED" BorderThickness="1">
                                        <Grid>
                                            <!-- Preview Canvas -->
                                            <Viewbox Stretch="Uniform" IsHitTestVisible="False">
                                                <InkPresenter Strokes="{Binding Strokes}" Width="1920" Height="1080" />
                                            </Viewbox>
                                            
                                            <!-- Page Title Overlay -->
                                            <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="4,2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Change Background Button (top-left) -->
                                            <Button Content="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Foreground="White" Background="#CC585858" BorderThickness="0" 
                                                    Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                    Cursor="Hand" Tag="{Binding Id}" Margin="4"
                                                    Click="BtnChangePageBg_Click" ToolTip="Đổi nền trang"/>
                                            
                                            <!-- Delete Button (top-right) -->
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                                                    Foreground="White" Background="#CCF38BA8" BorderThickness="0" 
                                                    Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Cursor="Hand" Click="BtnDeletePage_Click" Tag="{Binding Id}" Margin="4"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Right Insert Indicator -->
                                    <Border x:Name="RightInsertIndicator" Width="3" HorizontalAlignment="Right" 
                                            Background="#2E86DE" Visibility="Collapsed" Margin="0,0,-2,0" CornerRadius="2"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#2E86DE"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Add Page Menu -->
                    <StackPanel x:Name="PanelAddPageTypes" Visibility="Collapsed" Margin="0,12,0,0">
                        <!-- Pattern Selection -->
                        <TextBlock Text="Loại bảng:" FontSize="13" Foreground="#8888A8" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button x:Name="BtnNewPatternPlain" Style="{StaticResource ActiveToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                    Tag="Plain" Click="BtnNewPattern_Click" ToolTip="Trống">
                                <TextBlock Text="▫ Trống" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewPatternGrid" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                    Tag="Grid" Click="BtnNewPattern_Click" ToolTip="Ô Ly">
                                <TextBlock Text="▦ Ô Ly" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewPatternRuled" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                    Tag="Ruled" Click="BtnNewPattern_Click" ToolTip="Kẻ Ngang">
                                <TextBlock Text="☰ Kẻ ngang" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </WrapPanel>

                        <!-- Theme Selection -->
                        <TextBlock Text="Màu nền:" FontSize="13" Foreground="#8888A8" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button x:Name="BtnNewThemeDark" Style="{StaticResource ActiveToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                    Tag="Dark" Click="BtnNewTheme_Click" ToolTip="Nền Tối">
                                <TextBlock Text="🌙 Tối" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewThemeLight" Style="{StaticResource ToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                    Tag="Light" Click="BtnNewTheme_Click" ToolTip="Nền Sáng">
                                <TextBlock Text="☀ Sáng" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewThemeBlackboard" Style="{StaticResource ToolButtonStyle}" Width="90" Height="36" Margin="4" 
                                    Tag="Blackboard" Click="BtnNewTheme_Click" ToolTip="Bảng Đen">
                                <TextBlock Text="🌲 Bảng đen" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </WrapPanel>

                        <Border Height="1" Background="#E1E8ED" Margin="0,4,0,8"/>
                        <Button Content="✓ Tạo trang" Click="BtnCreateNewPage_Click" 
                                Style="{StaticResource ToolButtonStyle}" 
                                Width="140"
                                HorizontalAlignment="Center" Padding="20,8" FontSize="14" FontWeight="SemiBold"
                                Foreground="#2E86DE" Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Popup>

        <!-- ==========================================
             CHANGE BACKGROUND POPUP (separate floating)
             ========================================== -->
        <Popup x:Name="ChangeBgPopup"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Margin="8"
                    MinWidth="280">
                <Border.Effect>
                    <DropShadowEffect Color="#555555" BlurRadius="20" Opacity="0.35" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="TxtChangeBgTitle" Text="Đổi nền trang" FontSize="15" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" Cursor="Hand" Click="BtnCloseChangeBg_Click" ToolTip="Đóng"/>
                    </Grid>
                    
                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,12"/>

                    <!-- Pattern -->
                    <TextBlock Text="Loại bảng" FontSize="13" Foreground="#6B7280" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button x:Name="BtnEditPatternPlain" Style="{StaticResource ActiveToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                Tag="Plain" Click="BtnEditPattern_Click" ToolTip="Trống">
                            <TextBlock Text="▫ Trống" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditPatternGrid" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                Tag="Grid" Click="BtnEditPattern_Click" ToolTip="Ô Ly">
                            <TextBlock Text="▦ Ô Ly" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditPatternRuled" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                Tag="Ruled" Click="BtnEditPattern_Click" ToolTip="Kẻ Ngang">
                            <TextBlock Text="☰ Kẻ ngang" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </WrapPanel>

                    <!-- Theme -->
                    <TextBlock Text="Màu nền" FontSize="13" Foreground="#6B7280" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button x:Name="BtnEditThemeDark" Style="{StaticResource ActiveToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                Tag="Dark" Click="BtnEditTheme_Click" ToolTip="Nền Tối">
                            <TextBlock Text="🌙 Tối" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditThemeLight" Style="{StaticResource ToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                Tag="Light" Click="BtnEditTheme_Click" ToolTip="Nền Sáng">
                            <TextBlock Text="☀ Sáng" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditThemeBlackboard" Style="{StaticResource ToolButtonStyle}" Width="90" Height="36" Margin="4" 
                                Tag="Blackboard" Click="BtnEditTheme_Click" ToolTip="Bảng Đen">
                            <TextBlock Text="🌲 Bảng đen" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </WrapPanel>

                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,10"/>
                    <Button Content="✓ Xong" Click="BtnApplyChangeBg_Click" 
                            Style="{StaticResource ToolButtonStyle}" 
                            Width="140"
                            HorizontalAlignment="Center" Padding="24,8" FontSize="14" FontWeight="SemiBold"
                            Foreground="White" Background="#2E86DE" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Popup>


        <Border VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="24,24,0,0"
                Background="#CC2E86DE"
                BorderBrush="#2E86DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtModeIcon"
                           Text="&#xE76D;"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtModeIndicator"
                           Text="CHẾ ĐỘ VIẾT"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- FLOATING TOOLBAR DOCK (Foreground Layer)     -->
        <!-- ============================================ -->
        <Border x:Name="ToolbarBorder"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                Background="White"
                BorderBrush="#E1E8ED"
                BorderThickness="1"
                CornerRadius="15"
                Padding="8,6"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>
            
            <WrapPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <!-- === MODE TOGGLE: PEN / SELECT / ERASER === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPenMode"
                            Style="{StaticResource ActiveToolButtonStyle}"
                            Click="BtnPenMode_Click"
                            ToolTip="Chế độ Viết (P)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnSelectMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnSelectMode_Click"
                            ToolTip="Chế độ Chọn &amp; Thao tác (S)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M13.64,21.97C13.14,22.21 12.54,22 12.31,21.5L10.13,16.76L7.62,18.78C7.45,18.92 7.24,19 7,19A1,1 0 0,1 6,18V3A1,1 0 0,1 7,2C7.24,2 7.47,2.09 7.64,2.23L7.65,2.22L19.14,11.86C19.57,12.22 19.62,12.85 19.27,13.27C19.12,13.45 18.91,13.57 18.7,13.61L15.54,14.23L17.74,18.96C18,19.46 17.76,20.05 17.26,20.28L13.64,21.97Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnEraserStrokeMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnEraserStrokeMode_Click"
                            ToolTip="Tẩy Nét (E) - Xóa toàn bộ nét chạm vào">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnEraserPointMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnEraserPointMode_Click"
                            ToolTip="Tẩy Điểm (R) - Xóa chính xác điểm chạm">
                        <TextBlock Text="&#xE89A;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === COLOR PALETTE === -->
                <StackPanel x:Name="PanelColors" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnColorBlack"
                            Style="{StaticResource ActiveColorSwatchStyle}"
                            Background="#2F3542"
                            Click="BtnColor_Click" Tag="#2F3542"
                            ToolTip="Đen"/>
                    <Button x:Name="BtnColorRed"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#F38BA8"
                            Click="BtnColor_Click" Tag="#F38BA8"
                            ToolTip="Đỏ hồng"/>
                    <Button x:Name="BtnColorGreen"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#A6E3A1"
                            Click="BtnColor_Click" Tag="#A6E3A1"
                            ToolTip="Xanh lá"/>
                    <Button x:Name="BtnColorBlue"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#89B4FA"
                            Click="BtnColor_Click" Tag="#89B4FA"
                            ToolTip="Xanh dương"/>
                    <Button x:Name="BtnColorYellow"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#F9E2AF"
                            Click="BtnColor_Click" Tag="#F9E2AF"
                            ToolTip="Vàng"/>
                    <Button x:Name="BtnColorOrange"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#FAB387"
                            Click="BtnColor_Click" Tag="#FAB387"
                            ToolTip="Cam"/>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === STROKE WIDTH === -->
                <StackPanel x:Name="PanelStrokeWidth" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Thin -->
                    <Button x:Name="BtnStrokeThin"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnStrokeWidth_Click" Tag="3"
                            ToolTip="Nét Mảnh (3px)">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                            <TextBlock Text="S" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- Medium -->
                    <Button x:Name="BtnStrokeMedium"
                            Style="{StaticResource ActiveToolButtonStyle}"
                            Click="BtnStrokeWidth_Click" Tag="6"
                            ToolTip="Nét Vừa (6px)">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                            <TextBlock Text="M" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- Thick -->
                    <Button x:Name="BtnStrokeThick"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnStrokeWidth_Click" Tag="12"
                            ToolTip="Nét Dày (12px)">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="22" Height="22" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                            <TextBlock Text="L" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === ACTIONS: Undo / Redo / Delete / Clear / Fullscreen === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnUndo_Click"
                            ToolTip="Hoàn tác (Ctrl+Z)"
                            IsEnabled="False">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnRedo"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnRedo_Click"
                            ToolTip="Làm lại (Ctrl+Y)"
                            IsEnabled="False">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Style="{StaticResource ToolSeparator}"/>

                    <Button x:Name="BtnDeleteSelected"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnDeleteSelected_Click"
                            ToolTip="Xóa nét đã chọn (Delete)"
                            IsEnabled="False">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </Button>
                    <Button x:Name="BtnClearAll"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnClearAll_Click"
                            ToolTip="Xóa toàn bộ bảng">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Style="{StaticResource ToolSeparator}"/>

                    <Button x:Name="BtnFullscreen"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnFullscreen_Click"
                            ToolTip="Toàn màn hình (F11)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,12V6.75L9,5.43V11.91L3,12M20,3V11.75L10,11.9V5.21L20,3M3,13L9,13.09V19.9L3,18.75V13M20,13.25V22L10,20.09V13.1L20,13.25Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === PAGES BUTTON === -->
                <Button x:Name="BtnPages"
                        Style="{StaticResource ToolButtonStyle}"
                        Width="48" Height="48"
                        Margin="4,3"
                        Click="BtnPages_Click"
                        ToolTip="Quản lý trang">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
