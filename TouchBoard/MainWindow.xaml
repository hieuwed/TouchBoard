<Window x:Class="TouchBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TouchBoard"
        xmlns:controls="clr-namespace:TouchBoard.Controls"
        Title="Touch Board - Bảng Viết Tương Tác"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E2E"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:BackgroundTypeToBrushConverter x:Key="BgConverter" />
    </Window.Resources>

    <Grid>
        <!-- ============================================ -->
        <!-- INK CANVAS (Full Area, Background Layer)     -->
        <!-- ============================================ -->
        <Canvas x:Name="InfiniteCanvasContainer" ClipToBounds="True">
            <controls:SnappableInkCanvas x:Name="DrawingCanvas"
                       Width="100000" Height="100000"
                       Margin="-50000,-50000,0,0"
                       Background="#1E1E2E"
                       EditingMode="Ink"
                       ClipToBounds="False"
                       Focusable="True"
                       PreviewMouseDown="DrawingCanvas_PreviewMouseDown"
                       PreviewMouseMove="DrawingCanvas_PreviewMouseMove"
                       PreviewMouseUp="DrawingCanvas_PreviewMouseUp">
                <controls:SnappableInkCanvas.DefaultDrawingAttributes>
                    <DrawingAttributes Color="#CDD6F4"
                                       Width="6" Height="6"
                                       StylusTip="Ellipse"
                                       FitToCurve="True"
                                       IgnorePressure="True"/>
                </controls:SnappableInkCanvas.DefaultDrawingAttributes>
            </controls:SnappableInkCanvas>
        </Canvas>

        <!-- ============================================ -->
        <!-- SELECTION CONTEXT MENU (⋯ Button + Popup)   -->
        <!-- ============================================ -->
        <Canvas x:Name="SelectionOverlay" Panel.ZIndex="15">
            <Button x:Name="SelectionMenuButton"
                    Visibility="Collapsed"
                    Width="40" Height="40"
                    Click="SelectionMenuButton_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White"
                                BorderBrush="#E1E8ED"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#AAAAAA" BlurRadius="8" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="⋯" FontSize="22" FontWeight="Bold"
                                       Foreground="#2F3542"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-4,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Thumb x:Name="SelectionRotateThumb"
                   Visibility="Collapsed"
                   Width="32" Height="32"
                   Cursor="Hand"
                   DragStarted="SelectionRotateThumb_DragStarted"
                   DragDelta="SelectionRotateThumb_DragDelta"
                   DragCompleted="SelectionRotateThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#E1E8ED"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#CCCCCC" BlurRadius="6" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="↻" FontSize="18" Foreground="#8888A8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Canvas>

        <!-- Pen Settings Popup -->
        <Popup x:Name="PenSettingsPopup"
               PlacementTarget="{Binding ElementName=BtnPenMode}"
               Placement="Top"
               VerticalOffset="-15"
               HorizontalOffset="0"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <TextBlock Text="Cài đặt Bút"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#8888A8"
                               Margin="8,4,8,8"/>

                    <!-- Pen Type Section -->
                    <TextBlock Text="Loại bút" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                        <Button x:Name="BtnPenNormal" Style="{StaticResource ActiveToolButtonStyle}" Click="BtnPenType_Click" Tag="Normal" Width="70" Height="36" ToolTip="Bút thường" Content="Bút thường" FontSize="12" Margin="2,0"/>
                        <Button x:Name="BtnPenHighlighter" Style="{StaticResource ToolButtonStyle}" Click="BtnPenType_Click" Tag="Highlighter" Width="70" Height="36" ToolTip="Dạ quang" Content="Dạ quang" FontSize="12" Margin="2,0"/>
                    </StackPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Color Section -->
                    <TextBlock Text="Đổi màu" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <WrapPanel x:Name="PanelColors" Margin="4,0,4,4" HorizontalAlignment="Center" MaxWidth="140">
                        <Button x:Name="BtnColorBlack" Style="{StaticResource ActiveColorSwatchStyle}" Background="#2F3542" Click="BtnColor_Click" Tag="#2F3542" ToolTip="Đen" Width="30" Height="30" Margin="2"/>
                        <Button x:Name="BtnColorRed" Style="{StaticResource ColorSwatchStyle}" Background="#F38BA8" Click="BtnColor_Click" Tag="#F38BA8" ToolTip="Đỏ hồng" Width="30" Height="30" Margin="2"/>
                        <Button x:Name="BtnColorGreen" Style="{StaticResource ColorSwatchStyle}" Background="#A6E3A1" Click="BtnColor_Click" Tag="#A6E3A1" ToolTip="Xanh lá" Width="30" Height="30" Margin="2"/>
                        <Button x:Name="BtnColorBlue" Style="{StaticResource ColorSwatchStyle}" Background="#89B4FA" Click="BtnColor_Click" Tag="#89B4FA" ToolTip="Xanh dương" Width="30" Height="30" Margin="2"/>
                        <Button x:Name="BtnColorYellow" Style="{StaticResource ColorSwatchStyle}" Background="#F9E2AF" Click="BtnColor_Click" Tag="#F9E2AF" ToolTip="Vàng" Width="30" Height="30" Margin="2"/>
                        <Button x:Name="BtnColorOrange" Style="{StaticResource ColorSwatchStyle}" Background="#FAB387" Click="BtnColor_Click" Tag="#FAB387" ToolTip="Cam" Width="30" Height="30" Margin="2"/>
                        <Button x:Name="BtnColorCustom" Style="{StaticResource ToolButtonStyle}" Background="Transparent" BorderBrush="#E1E8ED" BorderThickness="1" Click="BtnCustomColor_Click" ToolTip="Thêm màu tuỳ chỉnh" Width="30" Height="30" Margin="2">
                            <TextBlock Text="+" FontSize="18" Foreground="#8888A8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Button>
                    </WrapPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Stroke Width Section -->
                    <TextBlock Text="Kích thước nét" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <StackPanel x:Name="PanelStrokeWidth" Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                        <Slider x:Name="SliderStrokeWidth" Width="100" Minimum="1" Maximum="50" Value="6" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="SliderStrokeWidth_ValueChanged" IsMoveToPointEnabled="True" Cursor="Hand"/>
                        <Border Width="36" Height="36" Background="#F1F2F6" CornerRadius="4" BorderBrush="#E1E8ED" BorderThickness="1">
                            <Ellipse Fill="#2F3542" 
                                     Width="{Binding Value, ElementName=SliderStrokeWidth}" 
                                     Height="{Binding Value, ElementName=SliderStrokeWidth}" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Eraser Settings Popup -->
        <Popup x:Name="EraserSettingsPopup"
               PlacementTarget="{Binding ElementName=BtnEraserMode}"
               Placement="Top"
               VerticalOffset="-15"
               HorizontalOffset="0"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <TextBlock Text="Cài đặt Tẩy"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#8888A8"
                               Margin="8,4,8,8"/>

                    <!-- Eraser Type Section -->
                    <TextBlock Text="Loại tẩy" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                        <Button x:Name="BtnEraserTypeStroke" Style="{StaticResource ActiveToolButtonStyle}" Click="BtnEraserType_Click" Tag="Stroke" Width="70" Height="36" ToolTip="Tẩy Nét (Xóa nguyên nét)" Content="Tẩy Nét" FontSize="12" Margin="2,0"/>
                        <Button x:Name="BtnEraserTypePoint" Style="{StaticResource ToolButtonStyle}" Click="BtnEraserType_Click" Tag="Point" Width="70" Height="36" ToolTip="Tẩy Điểm (Xóa theo điểm)" Content="Tẩy Điểm" FontSize="12" Margin="2,0"/>
                    </StackPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Eraser Size Section -->
                    <StackPanel x:Name="PanelEraserSize" Visibility="Collapsed">
                        <TextBlock Text="Kích thước tẩy điểm" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                        <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                            <Slider x:Name="SliderEraserSize" Width="100" Minimum="10" Maximum="200" Value="40" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="SliderEraserSize_ValueChanged" IsMoveToPointEnabled="True" Cursor="Hand"/>
                            <Border Width="36" Height="36" Background="#F1F2F6" CornerRadius="4" BorderBrush="#E1E8ED" BorderThickness="1" ClipToBounds="True">
                                <Ellipse Fill="#2F3542" 
                                         Width="{Binding Value, ElementName=SliderEraserSize}" 
                                         Height="{Binding Value, ElementName=SliderEraserSize}" 
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Selection Context Popup -->
        <Popup x:Name="SelectionPopup"
               PlacementTarget="{Binding ElementName=SelectionMenuButton}"
               Placement="Right"
               HorizontalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel MinWidth="200">
                    <TextBlock Text="Thao tác vùng chọn"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#8888A8"
                               Margin="8,4,8,8"/>

                    <!-- Color Section -->
                    <TextBlock Text="Đổi màu" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <WrapPanel Margin="4,0,4,4" HorizontalAlignment="Center" MaxWidth="140">
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#2F3542" Tag="#2F3542" Click="PopupColor_Click" ToolTip="Đen" Width="30" Height="30" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F38BA8" Tag="#F38BA8" Click="PopupColor_Click" ToolTip="Đỏ hồng" Width="30" Height="30" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#A6E3A1" Tag="#A6E3A1" Click="PopupColor_Click" ToolTip="Xanh lá" Width="30" Height="30" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#89B4FA" Tag="#89B4FA" Click="PopupColor_Click" ToolTip="Xanh dương" Width="30" Height="30" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F9E2AF" Tag="#F9E2AF" Click="PopupColor_Click" ToolTip="Vàng" Width="30" Height="30" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#FAB387" Tag="#FAB387" Click="PopupColor_Click" ToolTip="Cam" Width="30" Height="30" Margin="2"/>
                        <Button Style="{StaticResource ToolButtonStyle}" Background="Transparent" BorderBrush="#E1E8ED" BorderThickness="1" Click="PopupCustomColor_Click" ToolTip="Thêm màu tuỳ chỉnh" Width="30" Height="30" Margin="2">
                            <TextBlock Text="+" FontSize="18" Foreground="#8888A8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Button>
                    </WrapPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Stroke Width Section -->
                    <TextBlock Text="Kích thước nét" FontSize="13" Foreground="#2F3542" Margin="8,0,8,6"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="Center">
                        <Slider x:Name="SliderSelectionStrokeWidth" Width="100" Minimum="1" Maximum="50" Value="6" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="SliderSelectionStrokeWidth_ValueChanged" IsMoveToPointEnabled="True" Cursor="Hand"/>
                        <Border Width="36" Height="36" Background="#F1F2F6" CornerRadius="4" BorderBrush="#E1E8ED" BorderThickness="1">
                            <Ellipse Fill="#2F3542" 
                                     Width="{Binding Value, ElementName=SliderSelectionStrokeWidth}" 
                                     Height="{Binding Value, ElementName=SliderSelectionStrokeWidth}" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="4,6"/>

                    <!-- Action Buttons -->
                    <Button Click="PopupCopy_Click" Style="{StaticResource ContextMenuItemStyle}" ToolTip="Sao chép (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sao chép" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="PopupDelete_Click" Style="{StaticResource ContextMenuDangerItemStyle}" ToolTip="Xóa (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa vùng chọn" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Custom Color Picker Popup -->
        <Popup x:Name="CustomColorPopup"
               Placement="Right"
               HorizontalOffset="8"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel MinWidth="220">
                    <TextBlock Text="Bảng màu tuỳ chỉnh"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#2F3542"
                               Margin="0,0,0,12"/>

                    <!-- Palette -->
                    <WrapPanel HorizontalAlignment="Center" MaxWidth="180" Margin="0,0,0,12">
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#1E1E2E" Tag="#1E1E2E" Click="CustomPaletteColor_Click" ToolTip="Mocha Dark" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#313244" Tag="#313244" Click="CustomPaletteColor_Click" ToolTip="Mocha Surface" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#45475A" Tag="#45475A" Click="CustomPaletteColor_Click" ToolTip="Mocha Overlay" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F38BA8" Tag="#F38BA8" Click="CustomPaletteColor_Click" ToolTip="Red" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#FAB387" Tag="#FAB387" Click="CustomPaletteColor_Click" ToolTip="Peach" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F9E2AF" Tag="#F9E2AF" Click="CustomPaletteColor_Click" ToolTip="Yellow" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#A6E3A1" Tag="#A6E3A1" Click="CustomPaletteColor_Click" ToolTip="Green" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#94E2D5" Tag="#94E2D5" Click="CustomPaletteColor_Click" ToolTip="Teal" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#89DCEB" Tag="#89DCEB" Click="CustomPaletteColor_Click" ToolTip="Sky" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#89B4FA" Tag="#89B4FA" Click="CustomPaletteColor_Click" ToolTip="Blue" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#B4BEFE" Tag="#B4BEFE" Click="CustomPaletteColor_Click" ToolTip="Lavender" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#CBA6F7" Tag="#CBA6F7" Click="CustomPaletteColor_Click" ToolTip="Mauve" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F5C2E7" Tag="#F5C2E7" Click="CustomPaletteColor_Click" ToolTip="Pink" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#F2CDCD" Tag="#F2CDCD" Click="CustomPaletteColor_Click" ToolTip="Flamingo" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#EFF1F5" Tag="#EFF1F5" Click="CustomPaletteColor_Click" ToolTip="Latte Base" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#DCE0E8" Tag="#DCE0E8" Click="CustomPaletteColor_Click" ToolTip="Latte Crust" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#8C8FA1" Tag="#8C8FA1" Click="CustomPaletteColor_Click" ToolTip="Latte Overlay" Width="26" Height="26" Margin="2"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#4C4F69" Tag="#4C4F69" Click="CustomPaletteColor_Click" ToolTip="Latte Text" Width="26" Height="26" Margin="2"/>
                    </WrapPanel>

                    <Border Height="1" Background="#E1E8ED" Margin="0,0,0,12"/>

                    <!-- RGB Sliders -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="R" Grid.Row="0" Grid.Column="0" Foreground="#F38BA8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <Slider x:Name="SliderR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="200" VerticalAlignment="Center" Margin="0,0,0,4" ValueChanged="RgbSlider_ValueChanged" IsMoveToPointEnabled="True" Foreground="#F38BA8"/>
                        
                        <TextBlock Text="G" Grid.Row="1" Grid.Column="0" Foreground="#A6E3A1" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="200" VerticalAlignment="Center" Margin="0,0,0,4" ValueChanged="RgbSlider_ValueChanged" IsMoveToPointEnabled="True" Foreground="#A6E3A1"/>
                        
                        <TextBlock Text="B" Grid.Row="2" Grid.Column="0" Foreground="#89B4FA" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="200" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged" IsMoveToPointEnabled="True" Foreground="#89B4FA"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CustomColorPreview" Grid.Column="0" Background="#C8C8C8" CornerRadius="6" BorderBrush="#E1E8ED" BorderThickness="1" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="✓ Xong" Click="BtnApplyCustomColor_Click" 
                                Style="{StaticResource ToolButtonStyle}" 
                                Padding="16,6" FontSize="13" FontWeight="SemiBold"
                                Foreground="White" Background="#2E86DE" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Pages Context Popup -->
        <Popup x:Name="PagesPopup"
               PlacementTarget="{Binding ElementName=BtnPages}"
               Placement="Top"
               VerticalOffset="-15"
               HorizontalOffset="-100"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="8">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="15" Opacity="0.4" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel MinWidth="260">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Danh sách Trang" FontSize="16" FontWeight="Bold" Foreground="#2F3542" VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddPage" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" 
                                FontSize="14" FontWeight="Bold" Foreground="#2E86DE" Background="Transparent" 
                                BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Cursor="Hand" Click="BtnAddPage_Click" ToolTip="Tạo trang mới"/>
                    </Grid>
                    
                    <Border Height="1" Background="#E1E8ED" Margin="0,0,0,8"/>

                    <ListBox x:Name="LstPages" Background="Transparent" BorderThickness="0" 
                             MaxWidth="600" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="LstPages_SelectionChanged"
                             PreviewMouseLeftButtonDown="LstPages_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="LstPages_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="LstPages_PreviewMouseLeftButtonUp"
                             PreviewTouchDown="LstPages_PreviewTouchDown"
                             PreviewTouchMove="LstPages_PreviewTouchMove"
                             PreviewTouchUp="LstPages_PreviewTouchUp"
                             Drop="LstPages_Drop"
                             DragOver="LstPages_DragOver"
                             DragLeave="LstPages_DragLeave"
                             AllowDrop="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Left Insert Indicator -->
                                    <Border x:Name="LeftInsertIndicator" Width="3" HorizontalAlignment="Left" 
                                            Background="#2E86DE" Visibility="Collapsed" Margin="-2,0,0,0" CornerRadius="2"/>
                                    
                                    <!-- Main Thumbnail -->
                                    <Border Background="{Binding Theme, Converter={StaticResource BgConverter}}" 
                                            Width="160" Height="90" Margin="4" CornerRadius="6" ClipToBounds="True"
                                            BorderBrush="#E1E8ED" BorderThickness="1">
                                        <Grid>
                                            <!-- Preview Canvas -->
                                            <Viewbox Stretch="Uniform" IsHitTestVisible="False">
                                                <InkPresenter Strokes="{Binding Strokes}" Width="1920" Height="1080" />
                                            </Viewbox>
                                            
                                            <!-- Page Title Overlay -->
                                            <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="4,2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Change Background Button (top-left) -->
                                            <Button Content="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Foreground="White" Background="#CC585858" BorderThickness="0" 
                                                    Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                    Cursor="Hand" Tag="{Binding Id}" Margin="4"
                                                    Click="BtnChangePageBg_Click" ToolTip="Đổi nền trang"/>
                                            
                                            <!-- Delete Button (top-right) -->
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                                                    Foreground="White" Background="#CCF38BA8" BorderThickness="0" 
                                                    Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Cursor="Hand" Click="BtnDeletePage_Click" Tag="{Binding Id}" Margin="4"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Right Insert Indicator -->
                                    <Border x:Name="RightInsertIndicator" Width="3" HorizontalAlignment="Right" 
                                            Background="#2E86DE" Visibility="Collapsed" Margin="0,0,-2,0" CornerRadius="2"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#2E86DE"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Add Page Menu -->
                    <StackPanel x:Name="PanelAddPageTypes" Visibility="Collapsed" Margin="0,12,0,0">
                        <!-- Pattern Selection -->
                        <TextBlock Text="Loại bảng:" FontSize="13" Foreground="#8888A8" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button x:Name="BtnNewPatternPlain" Style="{StaticResource ActiveToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                    Tag="Plain" Click="BtnNewPattern_Click" ToolTip="Trống">
                                <TextBlock Text="▫ Trống" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewPatternGrid" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                    Tag="Grid" Click="BtnNewPattern_Click" ToolTip="Ô Ly">
                                <TextBlock Text="▦ Ô Ly" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewPatternRuled" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                    Tag="Ruled" Click="BtnNewPattern_Click" ToolTip="Kẻ Ngang">
                                <TextBlock Text="☰ Kẻ ngang" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </WrapPanel>

                        <!-- Theme Selection -->
                        <TextBlock Text="Màu nền:" FontSize="13" Foreground="#8888A8" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button x:Name="BtnNewThemeDark" Style="{StaticResource ToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                    Tag="Dark" Click="BtnNewTheme_Click" ToolTip="Nền Tối">
                                <TextBlock Text="🌙 Tối" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewThemeLight" Style="{StaticResource ActiveToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                    Tag="Light" Click="BtnNewTheme_Click" ToolTip="Nền Sáng">
                                <TextBlock Text="☀ Sáng" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnNewThemeBlackboard" Style="{StaticResource ToolButtonStyle}" Width="90" Height="36" Margin="4" 
                                    Tag="Blackboard" Click="BtnNewTheme_Click" ToolTip="Bảng Đen">
                                <TextBlock Text="🌲 Bảng đen" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </WrapPanel>

                        <Border Height="1" Background="#E1E8ED" Margin="0,4,0,8"/>
                        <Button Content="✓ Tạo trang" Click="BtnCreateNewPage_Click" 
                                Style="{StaticResource ToolButtonStyle}" 
                                Width="140"
                                HorizontalAlignment="Center" Padding="20,8" FontSize="14" FontWeight="SemiBold"
                                Foreground="#2E86DE" Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Popup>

        <!-- ==========================================
             CHANGE BACKGROUND POPUP (separate floating)
             ========================================== -->
        <Popup x:Name="ChangeBgPopup"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Margin="8"
                    MinWidth="280">
                <Border.Effect>
                    <DropShadowEffect Color="#555555" BlurRadius="20" Opacity="0.35" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="TxtChangeBgTitle" Text="Đổi nền trang" FontSize="15" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" Cursor="Hand" Click="BtnCloseChangeBg_Click" ToolTip="Đóng"/>
                    </Grid>
                    
                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,12"/>

                    <!-- Pattern -->
                    <TextBlock Text="Loại bảng" FontSize="13" Foreground="#6B7280" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button x:Name="BtnEditPatternPlain" Style="{StaticResource ActiveToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                Tag="Plain" Click="BtnEditPattern_Click" ToolTip="Trống">
                            <TextBlock Text="▫ Trống" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditPatternGrid" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                Tag="Grid" Click="BtnEditPattern_Click" ToolTip="Ô Ly">
                            <TextBlock Text="▦ Ô Ly" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditPatternRuled" Style="{StaticResource ToolButtonStyle}" Width="80" Height="36" Margin="4" 
                                Tag="Ruled" Click="BtnEditPattern_Click" ToolTip="Kẻ Ngang">
                            <TextBlock Text="☰ Kẻ ngang" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </WrapPanel>

                    <!-- Theme -->
                    <TextBlock Text="Màu nền" FontSize="13" Foreground="#6B7280" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button x:Name="BtnEditThemeDark" Style="{StaticResource ActiveToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                Tag="Dark" Click="BtnEditTheme_Click" ToolTip="Nền Tối">
                            <TextBlock Text="🌙 Tối" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditThemeLight" Style="{StaticResource ToolButtonStyle}" Width="70" Height="36" Margin="4" 
                                Tag="Light" Click="BtnEditTheme_Click" ToolTip="Nền Sáng">
                            <TextBlock Text="☀ Sáng" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnEditThemeBlackboard" Style="{StaticResource ToolButtonStyle}" Width="90" Height="36" Margin="4" 
                                Tag="Blackboard" Click="BtnEditTheme_Click" ToolTip="Bảng Đen">
                            <TextBlock Text="🌲 Bảng đen" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </WrapPanel>

                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,10"/>
                    <Button Content="✓ Xong" Click="BtnApplyChangeBg_Click" 
                            Style="{StaticResource ToolButtonStyle}" 
                            Width="140"
                            HorizontalAlignment="Center" Padding="24,8" FontSize="14" FontWeight="SemiBold"
                            Foreground="White" Background="#2E86DE" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Popup>




        <!-- Insert Tools Popup -->
        <Popup x:Name="InsertPopup"
               PlacementTarget="{Binding ElementName=BtnInsertMode}"
               Placement="Top"
               VerticalOffset="-15"
               HorizontalOffset="0"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel MinWidth="250">
                    <TextBlock Text="Chèn"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#8888A8"
                               Margin="8,4,8,8"/>

                    <!-- Tài liệu Section -->
                    <TextBlock Text="Tài liệu" FontSize="11" Foreground="#6B7280" Margin="8,0,8,4"/>
                    <UniformGrid Columns="4" Margin="4,0,4,4" VerticalAlignment="Top">
                        <Button x:Name="BtnInsertImage" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnInsertImage_Click" ToolTip="Chèn Ảnh">
                            <StackPanel>
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Ảnh" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border Height="1" Background="#E1E8ED" Margin="4,4,4,8"/>

                    <!-- Sơ đồ Section -->
                    <TextBlock Text="Sơ đồ &amp; Biểu diễn" FontSize="11" Foreground="#6B7280" Margin="8,0,8,4"/>
                    <UniformGrid Columns="4" Margin="4,0,4,4" VerticalAlignment="Top">
                        <Button x:Name="BtnInsertTable" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnUnderConstruction_Click" ToolTip="Bảng">
                            <StackPanel>
                                <TextBlock Text="&#xE262;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Bảng" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertShapes" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnInsertShapes_Click" ToolTip="Hình học">
                            <StackPanel>
                                <TextBlock Text="&#xF158;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Hình học" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertMindmap" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnUnderConstruction_Click" ToolTip="Sơ đồ tư duy">
                            <StackPanel>
                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Sơ đồ" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border Height="1" Background="#E1E8ED" Margin="4,4,4,8"/>

                    <!-- Công cụ Section -->
                    <TextBlock Text="Công cụ" FontSize="11" Foreground="#6B7280" Margin="8,0,8,4"/>
                    <UniformGrid Columns="4" Margin="4,0,4,4" VerticalAlignment="Top">
                        <Button x:Name="BtnInsertRuler" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnInsertRuler_Click" ToolTip="Thước thẳng">
                            <StackPanel>
                                <TextBlock Text="&#xECC6;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Thước" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertSetSquare" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnInsertSetSquare_Click" ToolTip="Eke">
                            <StackPanel>
                                <TextBlock Text="&#xF106;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Eke" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertProtractor" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnInsertProtractor_Click" ToolTip="Thước đo góc">
                            <StackPanel>
                                <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Đo góc" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertCompass" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnInsertCompass_Click" ToolTip="Compa">
                            <StackPanel>
                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Compa" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertStopwatch" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnUnderConstruction_Click" ToolTip="Đồng hồ">
                            <StackPanel>
                                <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Thời gian" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertCalendar" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnUnderConstruction_Click" ToolTip="Lịch">
                            <StackPanel>
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Lịch" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertSpotlight" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnUnderConstruction_Click" ToolTip="Đèn soi">
                            <StackPanel>
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Đèn soi" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsertScreenShade" Style="{StaticResource ToolButtonStyle}" Width="56" Height="56" Margin="2" Click="BtnUnderConstruction_Click" ToolTip="Che màn hình">
                            <StackPanel>
                                <TextBlock Text="&#xE7EA;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Màn che" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Shape Menu Popup -->
        <Popup x:Name="ShapeMenuPopup"
               PlacementTarget="{Binding ElementName=BtnInsertShapes}"
               Placement="Right"
               HorizontalOffset="5"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="2D Shapes" FontSize="12" FontWeight="SemiBold" Foreground="#8888A8" Margin="4,0,0,8"/>
                    <WrapPanel Grid.Row="1" MaxWidth="220" Margin="0,0,0,10">
                        <!-- 2D Shapes -->
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Rectangle" ToolTip="Hình chữ nhật">
                            <TextBlock Text="▭" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Ellipse" ToolTip="Hình Elip">
                            <TextBlock Text="⬭" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Triangle" ToolTip="Hình tam giác">
                            <TextBlock Text="△" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="RightTriangle" ToolTip="Tam giác vuông">
                            <TextBlock Text="⊿" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Parallelogram" ToolTip="Hình bình hành">
                            <TextBlock Text="▱" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Rhombus" ToolTip="Hình thoi">
                            <TextBlock Text="◇" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Trapezoid" ToolTip="Hình thang">
                            <TextBlock Text="⏢" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Pentagon" ToolTip="Ngũ giác">
                            <TextBlock Text="⬠" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Hexagon" ToolTip="Lục giác">
                            <TextBlock Text="⬡" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Star" ToolTip="Ngôi sao">
                            <TextBlock Text="★" FontSize="20"/>
                        </Button>
                        <!-- 3D Shapes -->
                        <TextBlock Text="3D Shapes" Width="200" FontSize="12" FontWeight="SemiBold" Foreground="#8888A8" Margin="4,8,0,8"/>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Cube" ToolTip="Hình lập phương">
                            <Viewbox Width="24" Height="24">
                                <Path Stroke="#C6D0F5" StrokeThickness="0.05" StrokeLineJoin="Round" Data="M0,0.25 L0.75,0.25 L0.75,1 L0,1 Z M0,0.25 L0.25,0 L1,0 L0.75,0.25 M1,0 L1,0.75 L0.75,1"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Cylinder" ToolTip="Hình trụ">
                            <Viewbox Width="24" Height="24">
                                <Path Stroke="#C6D0F5" StrokeThickness="0.05" StrokeLineJoin="Round" Data="M0,0.15 A0.5,0.15 0 0,1 1,0.15 A0.5,0.15 0 0,1 0,0.15 Z M0,0.15 L0,0.85 M1,0.15 L1,0.85 M0,0.85 A0.5,0.15 0 0,0 1,0.85"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Cone" ToolTip="Hình nón">
                            <Viewbox Width="24" Height="24">
                                <Path Stroke="#C6D0F5" StrokeThickness="0.05" StrokeLineJoin="Round" Data="M0.5,0 L0,0.85 M0.5,0 L1,0.85 M0,0.85 A0.5,0.15 0 0,0 1,0.85"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Sphere" ToolTip="Hình cầu">
                            <Viewbox Width="24" Height="24">
                                <Path Stroke="#C6D0F5" StrokeThickness="0.05" StrokeLineJoin="Round" Data="M0.5,0 A0.5,0.5 0 0,1 0.5,1 A0.5,0.5 0 0,1 0.5,0 Z M0,0.5 A0.5,0.15 0 0,0 1,0.5 M0.5,0 A0.15,0.5 0 0,0 0.5,1"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="TriangularPyramid" ToolTip="Hình chóp tam giác">
                            <Viewbox Width="24" Height="24">
                                <Path Stroke="#C6D0F5" StrokeThickness="0.05" StrokeLineJoin="Round" Data="M0.5,0 L0,0.8 M0.5,0 L1,0.8 M0.5,0 L0.5,1 M0,0.8 L0.5,1 M1,0.8 L0.5,1"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Width="40" Height="40" Margin="2" Click="InsertShape_Click" Tag="Frustum" ToolTip="Hình nón cụt">
                            <Viewbox Width="24" Height="24">
                                <Path Stroke="#C6D0F5" StrokeThickness="0.05" StrokeLineJoin="Round" Data="M0.2,0.15 A0.3,0.08 0 0,1 0.8,0.15 A0.3,0.08 0 0,1 0.2,0.15 Z M0.2,0.15 L0,0.85 M0.8,0.15 L1,0.85 M0,0.85 A0.5,0.15 0 0,0 1,0.85"/>
                            </Viewbox>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- ============================================ -->
        <!-- FLOATING TOOLBAR DOCK (Foreground Layer)     -->
        <!-- ============================================ -->
        <Border x:Name="ToolbarBorder"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                Background="White"
                BorderBrush="#E1E8ED"
                BorderThickness="1"
                CornerRadius="15"
                Padding="8,6"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>
            
            <WrapPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <!-- === MODE TOGGLE: PEN / SELECT / ERASER === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPenMode"
                            Style="{StaticResource ActiveToolButtonStyle}"
                            Click="BtnPenMode_Click"
                            ToolTip="Chế độ Viết (P)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnSelectMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnSelectMode_Click"
                            ToolTip="Chế độ Chọn &amp; Thao tác (S)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M13.64,21.97C13.14,22.21 12.54,22 12.31,21.5L10.13,16.76L7.62,18.78C7.45,18.92 7.24,19 7,19A1,1 0 0,1 6,18V3A1,1 0 0,1 7,2C7.24,2 7.47,2.09 7.64,2.23L7.65,2.22L19.14,11.86C19.57,12.22 19.62,12.85 19.27,13.27C19.12,13.45 18.91,13.57 18.7,13.61L15.54,14.23L17.74,18.96C18,19.46 17.76,20.05 17.26,20.28L13.64,21.97Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnEraserMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnEraserMode_Click"
                            ToolTip="Tẩy (E) - Bấm 2 lần để cài đặt">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>


                <!-- === ACTIONS: Undo / Redo / Delete / Clear / Fullscreen === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnUndo_Click"
                            ToolTip="Hoàn tác (Ctrl+Z)"
                            IsEnabled="False">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnRedo"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnRedo_Click"
                            ToolTip="Làm lại (Ctrl+Y)"
                            IsEnabled="False">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Style="{StaticResource ToolSeparator}"/>

                    <Button x:Name="BtnDeleteSelected"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnDeleteSelected_Click"
                            ToolTip="Xóa nét đã chọn (Delete)"
                            IsEnabled="False">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </Button>
                    <Button x:Name="BtnClearAll"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnClearAll_Click"
                            ToolTip="Xóa toàn bộ bảng">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Style="{StaticResource ToolSeparator}"/>

                    <Button x:Name="BtnInsertMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnInsertMode_Click"
                            ToolTip="Chèn tài liệu &amp; công cụ (I)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button x:Name="BtnFullscreen"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnFullscreen_Click"
                            ToolTip="Toàn màn hình (F11)">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,12V6.75L9,5.43V11.91L3,12M20,3V11.75L10,11.9V5.21L20,3M3,13L9,13.09V19.9L3,18.75V13M20,13.25V22L10,20.09V13.1L20,13.25Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === PAGES BUTTONS === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="BtnPrevPage"
                            Style="{StaticResource ToolButtonStyle}"
                            Width="36" Height="36"
                            Click="BtnPrevPage_Click"
                            ToolTip="Trang trước (PageUp)">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    
                    <Button x:Name="BtnPages"
                            Style="{StaticResource ToolButtonStyle}"
                            Width="44" Height="44"
                            Margin="2,0"
                            Click="BtnPages_Click"
                            ToolTip="Quản lý trang">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnNextPage"
                            Style="{StaticResource ToolButtonStyle}"
                            Width="36" Height="36"
                            Click="BtnNextPage_Click"
                            ToolTip="Trang sau (PageDown)">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- === SETTINGS / MENU === -->
                <Button x:Name="BtnSettings"
                        Style="{StaticResource ToolButtonStyle}"
                        Width="44" Height="44"
                        Margin="4,0,0,0"
                        Click="BtnSettings_Click"
                        ToolTip="Cài đặt">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Settings Popup -->
        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=BtnSettings}"
               Placement="Top"
               VerticalOffset="-10"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="8">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="15" Opacity="0.4" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <!-- Lưu dự án: nếu đã mở file thì lưu thẳng, nếu mới thì hiện dialog -->
                    <Button Click="BtnSave_Click" Style="{StaticResource ContextMenuItemStyle}"
                            ToolTip="Lưu dự án (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Lưu dự án"/>
                        </StackPanel>
                    </Button>
                    <!-- Lưu thành tên khác: luôn hiện dialog -->
                    <Button Click="BtnSaveAs_Click" Style="{StaticResource ContextMenuItemStyle}"
                            ToolTip="Lưu thành tên và vị trí khác">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA35;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Lưu thành..."/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnLoad_Click" Style="{StaticResource ContextMenuItemStyle}"
                            ToolTip="Mở dự án (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Mở dự án"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,4"/>
                    <Button Click="BtnExportPdf_Click" Style="{StaticResource ContextMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Xuất PDF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
