<Window x:Class="TouchBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Touch Board - Bảng Viết Tương Tác"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E2E"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- ============================================ -->
        <!-- BASE BUTTON STYLE (Touch-Friendly 56x56)     -->
        <!-- ============================================ -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#74C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTIVE TOOL BUTTON (Highlighted border for selected tool) -->
        <Style x:Key="ActiveToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#1E66F5"/>
            <Setter Property="BorderBrush" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- COLOR SWATCH BUTTON -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#74C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTIVE COLOR SWATCH (Ring indicator) -->
        <Style x:Key="ActiveColorSwatchStyle" TargetType="Button" BasedOn="{StaticResource ColorSwatchStyle}">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>

        <!-- STROKE WIDTH BUTTON -->
        <Style x:Key="StrokeWidthButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
        </Style>

        <!-- SEPARATOR -->
        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>

        <!-- DANGER BUTTON (Clear / Delete) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F38BA8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F38BA8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBA0AC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#EBA0AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- TOOLBAR (Top, Touch-Friendly)                -->
        <!-- ============================================ -->
        <Border Grid.Row="0"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,0,2"
                Padding="12,8">
            <WrapPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <!-- === MODE TOGGLE: PEN / SELECT / ERASER === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPenMode"
                            Style="{StaticResource ActiveToolButtonStyle}"
                            Click="BtnPenMode_Click"
                            ToolTip="Chế độ Viết (P)">
                        <TextBlock Text="✏️" FontSize="24"/>
                    </Button>
                    <Button x:Name="BtnSelectMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnSelectMode_Click"
                            ToolTip="Chế độ Chọn &amp; Thao tác (S)">
                        <TextBlock Text="👆" FontSize="24"/>
                    </Button>
                    <Button x:Name="BtnEraserStrokeMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnEraserStrokeMode_Click"
                            ToolTip="Tẩy Nét (E) - Xóa toàn bộ nét chạm vào">
                        <TextBlock Text="🧽" FontSize="24"/>
                    </Button>
                    <Button x:Name="BtnEraserPointMode"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnEraserPointMode_Click"
                            ToolTip="Tẩy Điểm (R) - Xóa chính xác điểm chạm">
                        <TextBlock Text="🧼" FontSize="24"/>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === COLOR PALETTE === -->
                <StackPanel x:Name="PanelColors" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnColorBlack"
                            Style="{StaticResource ActiveColorSwatchStyle}"
                            Background="#CDD6F4"
                            Click="BtnColor_Click" Tag="#CDD6F4"
                            ToolTip="Trắng ngà"/>
                    <Button x:Name="BtnColorRed"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#F38BA8"
                            Click="BtnColor_Click" Tag="#F38BA8"
                            ToolTip="Đỏ hồng"/>
                    <Button x:Name="BtnColorGreen"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#A6E3A1"
                            Click="BtnColor_Click" Tag="#A6E3A1"
                            ToolTip="Xanh lá"/>
                    <Button x:Name="BtnColorBlue"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#89B4FA"
                            Click="BtnColor_Click" Tag="#89B4FA"
                            ToolTip="Xanh dương"/>
                    <Button x:Name="BtnColorYellow"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#F9E2AF"
                            Click="BtnColor_Click" Tag="#F9E2AF"
                            ToolTip="Vàng"/>
                    <Button x:Name="BtnColorOrange"
                            Style="{StaticResource ColorSwatchStyle}"
                            Background="#FAB387"
                            Click="BtnColor_Click" Tag="#FAB387"
                            ToolTip="Cam"/>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === STROKE WIDTH === -->
                <StackPanel x:Name="PanelStrokeWidth" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStrokeThin"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnStrokeWidth_Click" Tag="3"
                            ToolTip="Nét Mảnh (3px)">
                        <Ellipse Width="8" Height="8" Fill="#CDD6F4"/>
                    </Button>
                    <Button x:Name="BtnStrokeMedium"
                            Style="{StaticResource ActiveToolButtonStyle}"
                            Click="BtnStrokeWidth_Click" Tag="6"
                            ToolTip="Nét Vừa (6px)">
                        <Ellipse Width="16" Height="16" Fill="White"/>
                    </Button>
                    <Button x:Name="BtnStrokeThick"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnStrokeWidth_Click" Tag="12"
                            ToolTip="Nét Dày (12px)">
                        <Ellipse Width="26" Height="26" Fill="#CDD6F4"/>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}"/>

                <!-- === ACTIONS: Undo / Redo / Delete / Clear / Fullscreen === -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnUndo_Click"
                            ToolTip="Hoàn tác (Ctrl+Z)"
                            IsEnabled="False" Opacity="0.4">
                        <TextBlock Text="↩️" FontSize="22"/>
                    </Button>
                    <Button x:Name="BtnRedo"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnRedo_Click"
                            ToolTip="Làm lại (Ctrl+Y)"
                            IsEnabled="False" Opacity="0.4">
                        <TextBlock Text="↪️" FontSize="22"/>
                    </Button>

                    <Border Style="{StaticResource ToolSeparator}"/>

                    <Button x:Name="BtnDeleteSelected"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnDeleteSelected_Click"
                            ToolTip="Xóa nét đã chọn (Delete)"
                            IsEnabled="False" Opacity="0.4">
                        <TextBlock Text="🗑️" FontSize="22"/>
                    </Button>
                    <Button x:Name="BtnClearAll"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnClearAll_Click"
                            ToolTip="Xóa toàn bộ bảng">
                        <TextBlock Text="🧹" FontSize="22"/>
                    </Button>

                    <Border Style="{StaticResource ToolSeparator}"/>

                    <Button x:Name="BtnFullscreen"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnFullscreen_Click"
                            ToolTip="Toàn màn hình (F11)">
                        <TextBlock Text="⛶" FontSize="26"/>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- === STATUS BAR (Mode Indicator) === -->
        <Border Grid.Row="0" 
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="16,0,0,-28"
                Background="#1E66F5"
                CornerRadius="6"
                Padding="12,4"
                Panel.ZIndex="10">
            <TextBlock x:Name="TxtModeIndicator"
                       Text="✏️ CHẾ ĐỘ VIẾT"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- ============================================ -->
        <!-- INK CANVAS (Full Area)                       -->
        <!-- ============================================ -->
        <InkCanvas x:Name="DrawingCanvas"
                   Grid.Row="1"
                   Background="#1E1E2E"
                   EditingMode="Ink"
                   SelectionChanged="DrawingCanvas_SelectionChanged"
                   ClipToBounds="True"
                   Focusable="True">
            <InkCanvas.DefaultDrawingAttributes>
                <DrawingAttributes Color="#CDD6F4"
                                   Width="6" Height="6"
                                   StylusTip="Ellipse"
                                   FitToCurve="True"
                                   IgnorePressure="True"/>
            </InkCanvas.DefaultDrawingAttributes>
        </InkCanvas>
    </Grid>
</Window>
